{
  "schemaVersion": 1,
  "id": "enso.clawbot",
  "name": "微信 Clawbot",
  "version": "0.1.1",
  "icon": "icon.svg",
  "description": "微信（WeChat）联系方式：扫码登录后，把扫码人的微信消息交给 EnsoCode 秘书，并把秘书的回复发回微信。",
  "engines": {
    "enso": ">=0.3.9"
  },
  "main": "main.mjs",
  "resident": true,
  "permissions": [
    "secretary.contact",
    "net.fetch",
    "process.background",
    "ui.view"
  ],
  "net": {
    "domains": [
      "ilinkai.weixin.qq.com",
      "novac2c.cdn.weixin.qq.com",
      "*.weixin.qq.com"
    ]
  },
  "contributes": {
    "contactChannels": [
      {
        "id": "wechat",
        "title": "微信",
        "icon": "icon.svg",
        "settingsView": "view.html"
      }
    ],
    "methods": [
      {
        "name": "state",
        "timeoutMs": 5000
      },
      {
        "name": "login",
        "timeoutMs": 20000
      },
      {
        "name": "verify",
        "timeoutMs": 5000
      },
      {
        "name": "logout",
        "timeoutMs": 10000
      }
    ]
  }
}
