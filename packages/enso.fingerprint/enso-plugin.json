{
  "schemaVersion": 1,
  "id": "enso.fingerprint",
  "name": "模型指纹",
  "version": "0.1.1",
  "description": "侧栏里看当前会话的模型最像参考库里的哪个模型：用 Fingerpoint Detector（lmfpd-sdk）出 3 道随机整数题，交给当前会话的模型作答，再在本机离线评分。显示最像的模型、家族、置信度、候选排名、每道题的解析情况和「像不像语言模型写的」检查。会话直接选了具体模型时，结果与会话模型 id 对照；用 Auto 这类虚拟模型时，宿主拿不到实际答题的模型，不做对照。手动点按钮才检测，每次 3 次模型调用；结果是参考库内的相似度排序，不是身份证明。",
  "icon": "icon.svg",
  "engines": {
    "enso": ">=0.3.8"
  },
  "main": "main.mjs",
  "permissions": [
    "ui.view",
    "agent.run",
    "net.fetch"
  ],
  "net": {
    "domains": [
      "lm.ikale.io",
      "cdn.jsdmirror.com"
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "fingerprint",
        "title": "模型指纹",
        "entry": "view.html"
      }
    ],
    "methods": [
      {
        "name": "start",
        "timeoutMs": 15000
      },
      {
        "name": "wait",
        "timeoutMs": 30000
      },
      {
        "name": "cancel",
        "timeoutMs": 5000
      },
      {
        "name": "snapshot",
        "timeoutMs": 5000
      }
    ]
  }
}
