{
  "schemaVersion": 1,
  "id": "enso.telegram",
  "name": "Telegram Bot",
  "version": "1.2.1",
  "icon": "icon.svg",
  "description": "用 Telegram Bot 远程使用 EnsoCode 会话：面板直填 Token 即连；私聊、群聊与论坛话题各自绑定任意会话（含秘书），面板一键跳到目标会话；管理员消息可信直达、普通用户按外部数据隔离；两层白名单与全群开放模式、逐话题免 @ 直发；上下文条数、限速攒批与提示词前置按路由配置；双向图片与相册；ask_user 按钮直接在群里作答。",
  "engines": {
    "enso": ">=0.3.14"
  },
  "main": "main.mjs",
  "resident": true,
  "permissions": [
    "process.background",
    "agent.inject",
    "agent.injectTrusted",
    "agent.observe",
    "agent.tool",
    "net.fetch",
    "session.create",
    "session.focus",
    "session.read",
    "session.readAll",
    "ui.openExternal",
    "ui.view"
  ],
  "net": {
    "domains": [
      "api.telegram.org"
    ]
  },
  "contributes": {
    "agentTools": [
      {
        "name": "telegram_reply",
        "description": "主动向本会话绑定的 Telegram 聊天发一条消息（如长任务的中途进度）。回复 Telegram 消息时不需要调用：本轮最终回复会自动发回并引用原消息。",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "要发送的文本（支持 Markdown）"
            },
            "target": {
              "type": "string",
              "description": "可选：指定路由 key（chatId 或 chatId:topicId），缺省发往本会话绑定的全部路由"
            },
            "replyTo": {
              "type": "integer",
              "description": "可选：要引用的 Telegram 消息 id（注入消息头里的 message_id）。本会话绑定了多个聊天时须同时给 target；原消息已删除时照常发送、不带引用"
            }
          },
          "required": [
            "text"
          ]
        }
      },
      {
        "name": "telegram_send_media",
        "description": "向本会话绑定的 Telegram 聊天发送 1-10 张本地图片（png/jpg/gif/webp，每张 ≤10MB）。多张默认合成相册。",
        "parameters": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "1-10 个本地图片绝对路径（须在 /tmp、/var/folders 或项目目录内）"
            },
            "caption": {
              "type": "string",
              "description": "图片说明（超过 1024 字符的部分会拆成独立消息）"
            },
            "asAlbum": {
              "type": "boolean",
              "description": "默认 true：多张合成相册；false 逐张发送"
            },
            "target": {
              "type": "string",
              "description": "可选：指定路由 key，缺省发往本会话绑定的全部路由"
            },
            "replyTo": {
              "type": "integer",
              "description": "可选：要引用的 Telegram 消息 id（注入消息头里的 message_id），只引在第一条（相册整组算一条）。本会话绑定了多个聊天时须同时给 target"
            }
          },
          "required": [
            "files"
          ]
        }
      }
    ],
    "events": [
      {
        "event": "agent_end"
      },
      {
        "event": "tool_call"
      },
      {
        "event": "input"
      },
      {
        "event": "ask_request"
      },
      {
        "event": "ask_resolved"
      }
    ],
    "configuration": [
      {
        "key": "botToken",
        "title": "Bot Token",
        "description": "从 @BotFather 获取",
        "secret": true
      }
    ],
    "views": [
      {
        "id": "telegram",
        "title": "Telegram Bot",
        "entry": "view.html",
        "scope": "global"
      }
    ],
    "methods": [
      {
        "name": "state",
        "timeoutMs": 15000
      },
      {
        "name": "connect",
        "timeoutMs": 15000
      },
      {
        "name": "disconnect",
        "timeoutMs": 15000
      },
      {
        "name": "pair",
        "timeoutMs": 15000
      },
      {
        "name": "bind",
        "timeoutMs": 15000
      },
      {
        "name": "unbind",
        "timeoutMs": 15000
      },
      {
        "name": "route",
        "timeoutMs": 15000
      },
      {
        "name": "fresh",
        "timeoutMs": 15000
      },
      {
        "name": "globalAllow",
        "timeoutMs": 15000
      },
      {
        "name": "approve",
        "timeoutMs": 15000
      },
      {
        "name": "open",
        "timeoutMs": 15000
      },
      {
        "name": "focus",
        "timeoutMs": 15000
      },
      {
        "name": "admin",
        "timeoutMs": 15000
      },
      {
        "name": "cancelPair",
        "timeoutMs": 15000
      }
    ]
  }
}
