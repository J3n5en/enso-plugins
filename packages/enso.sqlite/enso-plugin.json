{
  "schemaVersion": 1,
  "id": "enso.sqlite",
  "name": "SQLite",
  "version": "0.1.0",
  "icon": "icon.svg",
  "description": "浏览和查询 SQLite 数据库：可排序、筛选的表格，SQL 查询，以及表、视图、索引和触发器的 CREATE 语句。只读。",
  "engines": { "enso": ">=0.3.4" },
  "main": "main.mjs",
  "permissions": ["ui.view", "fs.read"],
  "fs": { "read": ["."] },
  "contributes": {
    "views": [{ "id": "sqlite", "title": "SQLite", "entry": "browser.html" }],
    "fileViewers": [
      {
        "id": "sqlite",
        "title": "SQLite",
        "entry": "browser.html",
        "extensions": [".db", ".sqlite", ".sqlite3"],
        "default": true
      }
    ],
    "methods": [
      { "name": "open", "timeoutMs": 120000 },
      { "name": "find", "timeoutMs": 30000 },
      { "name": "rows", "timeoutMs": 120000 },
      { "name": "query", "timeoutMs": 120000 },
      { "name": "schema", "timeoutMs": 60000 },
      { "name": "cell", "timeoutMs": 60000 },
      { "name": "export", "timeoutMs": 120000 },
      { "name": "cancel", "timeoutMs": 15000 }
    ]
  }
}
